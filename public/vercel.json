{
    "rewrites": [
        { "source": "/descargar", "destination": "/descargar.html" },
        { "source": "/privacidad", "destination": "/privacidad.html" },
        { "source": "/normas", "destination": "/normas.html" },
        { "source": "/borrar-cuenta", "destination": "/borrar-cuenta.html" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "redirects": [
        {
            "source": "/www/(.*)",
            "destination": "https://veoveo.dripdev.dev/$1",
            "permanent": true
        },
        {
            "source": "/veoveo-latest.apk",
            "destination": "https://github.com/roblesgg/VeoVeo/releases/latest/download/veoveo-latest.apk",
            "permanent": false
        },
        {
            "source": "/apk",
            "destination": "https://github.com/roblesgg/VeoVeo/releases/latest/download/veoveo-latest.apk",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
            ]
        },
        {
            "source": "/(privacidad|normas|borrar-cuenta)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
                }
            ]
        },
        {
            "source": "/.well-known/(.*)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                }
            ]
        }
    ]
}
