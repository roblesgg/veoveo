{
  "name": "veoveo",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:test": "cross-env APP_ENV=test expo run:android",
    "ios": "expo run:ios",
    "web:deploy": "powershell -Command \"Remove-Item -Path public/index.html, public/_expo, public/static, public/assets -Recurse -ErrorAction SilentlyContinue; npx expo export --platform web; Copy-Item -Path dist/* -Destination public/ -Recurse -Force; Remove-Item -Path dist -Recurse -Force; Copy-Item -Path vercel.json -Destination public/vercel.json -Force; node scripts/patch-web-html.mjs; Set-Location public; vercel --prod --yes; vercel alias set public-iota-sepia.vercel.app veoveo.dripdev.dev; Set-Location ..\"",
    "web:alias": "vercel alias set public-iota-sepia.vercel.app veoveo.dripdev.dev",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:reglas": "firebase emulators:exec --only firestore,storage --project demo-veoveo \"node --test tests/reglas/firestore.test.mjs\"",
    "test:migracion": "firebase emulators:exec --only firestore --project demo-veoveo \"node --test tests/migracion/migracion.test.mjs\"",
    "security:check": "node scripts/check-security.mjs",
    "clean": "powershell -ExecutionPolicy Bypass -Command \"rm -Recurse -Force .expo, android, backups/recycled/*\"",
    "env:sync": "node scripts/sync-firebase-env.mjs",
    "release": "node scripts/push-version.mjs",
    "notify-users": "node scripts/notify-all-users.mjs",
    "lanzar": "node scripts/lanzar.mjs",
    "lint": "eslint src app.config.js scripts --ext .js,.jsx,.ts,.tsx,.mjs",
    "format": "prettier --write .",
    "eas-build-post-install": "node scripts/eas-post-install.js"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@tabler/icons-react-native": "3.49.0",
    "@tanstack/query-async-storage-persister": "5.101.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "5.101.0",
    "expo": "~54.0.33",
    "expo-asset": "^12.0.13",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.11.0",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^15.0.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "firebase-admin": "^13.7.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
