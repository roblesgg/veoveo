{
  "expo": {
    "name": "VeoVeo",
    "slug": "veoveo",
    "scheme": "veoveo",
    "version": "3.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roblesgg.veoveo"
    },
    "android": {
      "package": "com.roblesgg.veoveo",
      "adaptiveIcon": {
        "backgroundColor": "#013A85",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-fondo.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 42,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "veoveo.dripdev.dev", "pathPrefix": "/movie" },
            { "scheme": "https", "host": "veoveo.dripdev.dev", "pathPrefix": "/actor" },
            { "scheme": "https", "host": "veoveo.dripdev.dev", "pathPrefix": "/chat" },
            { "scheme": "https", "host": "veoveo.dripdev.dev", "pathPrefix": "/match" },
            { "scheme": "https", "host": "veoveo.dripdev.dev", "pathPrefix": "/solicitudes" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "baseUrl": "/app"
    },
    "updates": {
      "url": "https://u.expo.dev/db438c91-21eb-4020-a3ad-efec69cef405"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacion.png",
          "color": "#69DFD9"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "db438c91-21eb-4020-a3ad-efec69cef405"
      }
    }
  }
}